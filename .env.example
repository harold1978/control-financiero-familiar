# Copia este archivo a `.env` y completa los datos de TU proyecto de Firebase
# (consola de Firebase -> Configuración del proyecto -> Tus apps -> SDK de Firebase).
#
# Las variables con prefijo EXPO_PUBLIC_ se incrustan en el bundle: NO son
# secretos. Por eso la protección real se hace con las reglas de
# firestore.rules y Firebase App Check (ver COMPLIANCE.md).
#
# Importante: el archivo que usa la app se llama `.env` (sin `.example`).
# Después de crearlo o modificarlo hay que reiniciar el servidor de Expo.

EXPO_PUBLIC_FIREBASE_API_KEY="tu-api-key"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="tu-project-id"
EXPO_PUBLIC_FIREBASE_APP_ID="tu-app-id"

# Opcionales (si no se indican se calculan a partir del project id):
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-project-id.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-project-id.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="tu-sender-id"
